DATABASE_URL=postgresql+psycopg://hammerz:hammerz@postgres:5432/hammerz
# Replace all three below before docker compose up (≥32 chars each; not change-me).
JWT_SECRET=change-me
HMAC_SECRET=change-me
ALIAS_SECRET=change-me
DEPLOYMENT_ID=hammerz
AUDIT_DIR=/var/lib/hammerz/audit
MAX_DEPOSIT_CENTS=10000000
MAX_BIDDER_TOTAL_CENTS=100000000
MAX_BID_CENTS=100000000
SETTLE_INTERVAL_SECONDS=2
# WebSocket Origin allowlist (not HTTP CORS). Local Compose + Vite dev; public deploy: https://your.domain only.
CORS_ORIGINS=http://localhost,http://localhost:5173
# Public hostname for Caddy Automatic HTTPS. Leave unset for local HTTP on port 80.
# SITE_ADDRESS=auctions.example.com
