# Unset SITE_ADDRESS → listen on :80. Production: SITE_ADDRESS=<public-hostname>
{$SITE_ADDRESS::80} {
	@api path /api/*
	@ws path /ws/*
	@health path /health/*

	handle @api {
		reverse_proxy backend:8000
	}
	handle @ws {
		reverse_proxy backend:8000
	}
	handle @health {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
